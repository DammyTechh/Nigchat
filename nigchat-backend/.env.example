# ---------------------------------------------------------------------------
# NigChat backend configuration
#
#   cp .env.example .env
#
# The server validates this at boot and refuses to start on an unsafe
# configuration rather than running insecurely.
# ---------------------------------------------------------------------------

# --- core ---
BIND_ADDR=0.0.0.0:8080
ENVIRONMENT=development          # development | staging | production
RUST_LOG=nigchat_server=debug,nigchat_api=debug,nigchat_application=debug,tower_http=info,sqlx=warn

# --- data stores ---
DATABASE_URL=postgres://nigchat:nigchat@localhost:5432/nigchat
DATABASE_MAX_CONNECTIONS=20
REDIS_URL=redis://localhost:6379

# --- secrets ---
# Generate BOTH with: openssl rand -hex 32
# They must differ, must be at least 32 characters, and must never be committed.
# Rotating JWT_SECRET signs everyone out; rotating HASH_PEPPER invalidates every
# stored token hash, so plan rotations deliberately.
JWT_SECRET=change_me_dev_only_0000000000000000000000000000000000000000000000
HASH_PEPPER=change_me_dev_only_1111111111111111111111111111111111111111111111
ACCESS_TOKEN_TTL_SECONDS=900

# --- development conveniences ---
# Returns the OTP in the API response instead of sending an SMS.
# The server REFUSES TO BOOT with this enabled outside development.
OTP_DEBUG_ECHO=true
# Swagger UI at /docs. Defaults to on in development, off elsewhere.
ENABLE_DOCS=true

# Believe X-Forwarded-For / X-Real-IP. Enable ONLY when this server sits behind
# a proxy you control that overwrites those headers. Enabling it on a directly
# reachable server lets an attacker forge their IP and bypass the per-IP OTP
# limit. Set to true when running behind the bundled nginx.
TRUST_PROXY_HEADERS=false

# --- web client ---
# Exact origins, comma separated. Never a wildcard: a wildcard would let any
# site make credentialed calls for a signed-in user. Leave empty for
# mobile-only deployments.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- SMS (required outside development) ---
# Works with Termii, Africa's Talking, Twilio and similar.
# SMS_ENDPOINT=https://api.ng.termii.com/api/sms/send
# SMS_API_KEY=
SMS_SENDER_ID=NigChat

# --- push notifications ---
# Optional. Without them push is disabled and messaging still works.
# FCM_PROJECT_ID=
# FCM_ACCESS_TOKEN=            # OAuth2 bearer for the service account
# APNS_TOPIC=com.nigchat.app   # your iOS bundle id
# APNS_AUTH_TOKEN=             # ES256 JWT, refresh at least hourly
