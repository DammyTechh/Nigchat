# Copy to .env and set to your machine's LAN address.
#   Windows: ipconfig      -> "IPv4 Address" of the active Wi-Fi adapter
#   macOS:   ipconfig getifaddr en0
#
# Not localhost: on a physical device, localhost is the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.62:8080
EXPO_PUBLIC_WS_URL=ws://192.168.1.62:8080
